PORT=7000
CLIENT_URL=http://localhost:5002

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>

# Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Email verification
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRES_MIN=1440

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Placement Simulator <no-reply@placement-simulator.local>

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ──────────────────────────────────────────────
# AI Provider  (used by the main aiService)
# ollama | groq | gemini
# ──────────────────────────────────────────────
AI_PROVIDER=groq

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# Groq — KEY_1 is used by the main aiService; KEY_2 is the second slot
# for the dual-API parallel resume parser.
GROQ_API_KEY=your_groq_api_key_1_here
GROQ_API_KEY_2=your_groq_api_key_2_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# Gemini — same pattern: KEY_1 for main service, KEY_2 for dual parser.
GEMINI_API_KEY=your_gemini_api_key_1_here
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL=gemini-1.5-flash

# ──────────────────────────────────────────────
# Dual-API resume parser
# Which provider's two keys to use for parallel extraction.
# groq | gemini
# ──────────────────────────────────────────────
DUAL_API_PROVIDER=groq